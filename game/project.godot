; Engine configuration file.
; VERDANT SIGNAL — Production Godot 4 Project Root
;
; Version Compatibility Note (DDL-015):
;   Minimum feature baseline is set to Godot 4.3 (required for TileMapLayer,
;   2D physics_interpolation, and AudioStreamInteractive/Synchronized).
;   Godot 4.3, 4.4, 4.5, 4.6, and 4.7+ on Windows will open and cleanly adopt
;   this configuration without triggering a "newer version" rejection.
;
; Visual Prototype Gate Note (DDL-011):
;   Default viewport is 480x270 (Oblique 3/4 Top-Down, 16x16 tiles, 16x24 Mara)
;   with integer pixel scaling. A/B validation against 640x360 on 1080p/1440p
;   Windows monitors is planned for Stage 05 Visual Prototype Gate.

config_version=5

[application]

config/name="VERDANT SIGNAL"
config/description="Painterly 2.5D Oblique 3/4 Top-Down Xenobiological Exploration, Ecological Survival, and Field-Science Mystery on Oura-IV (Catalog K-419b)."
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio_director.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_cast=1

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"


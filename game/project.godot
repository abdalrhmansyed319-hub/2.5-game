[layer_names]

2d_physics/layer_1="world_solid"
2d_physics/layer_2="water_barrier"
2d_physics/layer_3="player_body"
2d_physics/layer_4="fauna_body"
2d_physics/layer_5="interactable_flora"
2d_physics/layer_6="acoustic_sensor"
2d_physics/layer_7="hazard_zone"
2d_physics/layer_8="canopy_occluder"

[physics]

common/physics_interpolation=true
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/fallback_to_angle=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0705882, 0.0862745, 0.109804, 1)

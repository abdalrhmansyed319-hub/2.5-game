; Engine configuration file.
; VERDANT SIGNAL — Production Godot 4 Project Root
;
; Verified Windows Target Baseline:
;   Godot 4.7.2-stable (Official) | Windows | Intel HD Graphics 3000 (1366x768 @ 60 Hz)
;   Renderer: GL Compatibility (OpenGL 3 with automatic ANGLE fallback on OpenGL 3.1 GPUs).
;   Note: Do not force Vulkan or D3D12; HD Graphics 3000 hardware caps at D3D10.1 / OpenGL 3.1.
;
; Approved V8.0 Living World Pixel-Art Baseline:
;   Native viewport 640x360 (1:1 unmodified 88x88 character & handcrafted living forest),
;   1280x720 (2x exact integer scale on 1366x768 Intel HD 3000; 3x = 1920x1080),
;   Nearest filtering, MSAA 2D off, HDR 2D off, pixel-snapped transforms/vertices.

config_version=5

[application]

config/name="VERDANT SIGNAL"
config/description="Painterly 2.5D Oblique 3/4 Top-Down Xenobiological Exploration, Ecological Survival, and Field-Science Mystery on Oura-IV (Catalog K-419b)."
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio_director.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_cast=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

